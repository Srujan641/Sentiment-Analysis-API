# Copy to .env and adjust. Every setting in app/core/config.py can be set here.
MODEL_NAME_OR_PATH=models/distilbert-sentiment   # local dir or a Hugging Face Hub repo id
DEVICE=auto                                      # auto | cpu | cuda | mps
INFERENCE_BATCH_SIZE=32                          # max texts per /batch call == one forward pass
MAX_SEQUENCE_LENGTH=256
UNCERTAINTY_THRESHOLD=0.75                       # below this confidence a prediction is flagged uncertain

API_KEYS=change-me-1,change-me-2                 # comma separated
REQUIRE_API_KEY=false
RATE_LIMIT_ANONYMOUS=60/minute
RATE_LIMIT_AUTHENTICATED=300/minute
RATE_LIMIT_STORAGE_URI=memory://                 # e.g. redis://redis:6379/0 for multiple replicas

CORS_ORIGINS=*
LOG_LEVEL=INFO
LOG_JSON=true

PREDICTION_LOG_PATH=data/predictions.jsonl       # feeds scripts/drift_report.py
DRIFT_REFERENCE_PATH=models/distilbert-sentiment/reference_stats.json
DRIFT_WINDOW=1000

# Training
WANDB_PROJECT=sentiment-analysis-distilbert

# Review sources
FIRECRAWL_API_KEY=                               # enables the web connector (firecrawl.dev)
STORE_COUNTRY=in                                 # App Store country for search and reviews
YOUTUBE_API_KEY=                                 # YouTube Data API v3 (console.cloud.google.com): comments on review videos
REDDIT_CLIENT_ID=                                # planned: reddit.com/prefs/apps (script app)
REDDIT_CLIENT_SECRET=

# Database: SQLite by default; Postgres for real use (run `alembic upgrade head`)
# DATABASE_URL=postgresql+psycopg://reviewpulse:PASSWORD@localhost:5432/reviewpulse
